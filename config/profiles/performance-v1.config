# name: performance-v1
# publish: no
# JTS22 PLAYA, a performance build for the M-VAVE FM-1: created by JFS with help from Claude (Anthropic), 2026.
# Built on Optimist by w0ts and contributors (github.com/w0ts/optimist), GPL-3.0-only; this file is part of that work
# and under the same licence (LICENSE).
# JTS22 performance-only build (spec.md Prompt 4): performance-v1 minus the sequencer extras, sampling,
# SD / Wi-Fi, punch-in, macros, unused engines and inserts. The step sequencer core cannot be compiled out
# (events_block also runs MIDI in, keys, arp); it is made inert under PERF (no transport start).
# Memory management (unchanged: LAYOUT 6 keeps the project log, which needs PATTERNS)
LAYOUT=6
# Synth engines: ANALOG (fallback), DIGITAL (track 3), FM6 + packs, PROPHET, JUNO
ENG_ANALOG=3
A2_LADR=1
A2_OTA=1
A2_DIOD=0
A2_MS20=0
ENG_DIGITAL=3
DIG_TONE=0
ENG_PHASE=0
ENG_LOFI=0
ENG_SAMPLE=0
ENG_FORMANT=0
ENG_TRIO=0
ENG_DRAWBAR=0
ENG_GRAIN=0
ENG_FM6=2
FM6_KEYS=0
FM6_SYSEX=1
FM6_PK_KEYS=1
FM6_PK_BASS=1
FM6_PK_BELLS=1
FM6_PK_PADS=1
FM6_PK_80S=1
UP_FM6=1
ENG_PLAITS=0
ENG_STRINGS=0
ENG_PROPHET=2
ENG_PHYS=0
ENG_ACID=0
ENG_JUNO=2
# Drums: the synthesised kits (GM note map on ch10)
DRUMS=1
DRUM_SYNTH=1
DS_KAWA=0
DS_PLAITS=0
DRUM_X0X909=0
DRUM_X0X808=0
DRUM_SAMPLED=0
KIT_ACOUSTIC=0
KIT_DEEP=0
KIT_TIGHT=0
KIT_BRIGHT=0
KIT_DUST=0
DRUM_EDIT=1
DS_NTUNE=1
DRUM_USR=0
DRUM_KITS=0
# Sample sets
SET_PIANO=0
SET_BASS=0
SET_VIBES=0
SET_HORNS=0
SET_STRGS=0
SET_FLUTE=0
SET_SCRCH=0
# FX: sends REV CHO DLY, track filter, master comp/limiter, DIST, JUNO CHORUS
FX_DIST=1
FX_CHORUS=1
FX_DELAY=1
DLY_LEN=16384
FX_REVERB=1
REV_ROOM=0
REV_PLATE=0
REV_FDN8=1
REV_POOL=1
REV_AIRWIN=0
SPRING=0
FX_SLICER=0
FX_PUNCH=0
PUNCH_LATCH=0
FX_DJF=0
FX_DUST=0
FX_DUCK=0
MASTER_COMP=1
RET_FB=0
TRK_FILT=1
TFLT_RESO=1
INS_FOLD=0
INS_FUZZ=0
INS_PHASER=0
INS_FORMANT=0
INS_WIDTH=0
INS_SFOLD=0
INS_RECT=0
INS_HARM=0
INS_RING=0
INS_SUBOCT=0
INS_SLEW=0
INS_TAPE=0
INS_SPIT=0
INS_DELAY=0
INS_JCHORUS=1
INS_FLANGER=0
INS_XDLY=0
INS_GATER=0
# Sequencer: all extras off (PATTERNS stays: the project log of LAYOUT 6)
CHORDPLUS=0
SECTIONS=16
SNAPSHOTS=0
PATTERNS=1
UNDO_HISTORY=0
MACROS=0
ENERGY=0
LANE_FX=0
REC_PLAIN=0
NOTEGEN=0
EX_NOTEGEN=0
CHANCE=0
QNT_SEQ=0
MOTION=0
REC_MODES=0
SL24_XSTEP=0
DIV_LONG=0
MICRO=0
FILLS=0
PLOCK=0
QCHAIN=0
COND=0
SEQTOOLS=0
GEN_GRIDS=0
GRIDS_EUCLID=0
GRIDS_LFO=0
GRIDS_VEL=0
# Connectivity: USB + TRS + BLE MIDI in, no clock, no note out
USB_CONSOLE=0
USB_AUDIO=0
UART=1
MIDI_CLOCK=0
MIDI_EXPR=1
PERF=1
MIDI_NOTEOUT=0
BLE=1
BLE_BOND=1
BLE_CENTRAL=3
BT_AUDIO=0
WIFI_LINK=0
WIFI_AP=0
USB_HOST=0
# UI
MISSING_WARN=1
FAVORITES=0
PARAM_HELP=0
SYS_DEBUG=0
SYS_TOP=0
KNOB_ACCEL=1
LCD_BAUD=0
DIV_ORDER=1
# System: editor = backup / restore + librarian only
EDITOR=1
BACKUP=1
LIBRARIAN=1
ED_LIVE=0
ED_MIX=0
ED_SEQ=0
ED_SCREENS=0
ED_MIRROR=0
LIVE_SAVE=0
CPU_GUARD=1
CACHE_RAM=0
ASM=1
SEQ_RAM=0
SL24_SAFE=0
